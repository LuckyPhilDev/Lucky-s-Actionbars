package-as: Luckys_Actionbars

move-folders:
  Luckys_Actionbars/src: Luckys_Actionbars

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

externals:
  src/Libs/LuckysUtils:
    url: https://github.com/LuckyPhilDev/LuckyUtils
    tag: latest

ignore:
  - tests

enable-nolib-creation: no
